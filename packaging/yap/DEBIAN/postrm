#!/bin/sh
set -e

# postrm de yap
#  - remove: conserva la configuracion del administrador
#  - purge:  elimina /etc/yap
# dpkg gestiona /etc/apparmor.d/usr.local.bin.yap como conffile.
# Nunca toca ~/.config/yap/ (progreso, historial, confirmaciones del estudiante)

case "$1" in
    remove)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    purge)
        rm -rf /etc/yap /run/yap
        rm -f /lib/systemd/system/yap-daemon.service \
              /lib/systemd/system/yap-sync.service \
              /lib/systemd/system/yap-sync.timer
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
