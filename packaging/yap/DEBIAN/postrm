#!/bin/sh
set -e

# postrm de yap
#  - remove: conserva la configuracion del administrador
#  - purge:  elimina /etc/yap
# dpkg gestiona /etc/apparmor.d/usr.local.bin.yap como conffile.
# Nunca toca ~/.config/yap/ (progreso, historial, confirmaciones del estudiante)

case "$1" in
    purge)
        rm -rf /etc/yap
        ;;
esac

exit 0
