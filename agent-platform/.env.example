# Quienes clonan el repo rellenan esto en el runtime de Agent Platform.
# El alumno no usa este archivo.

GOOGLE_CLOUD_PROJECT=yap-chincolinux
GOOGLE_CLOUD_LOCATION=southamerica-west1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE

# Modelo fijado en agent.py: gemini-3.7-flash
YAP_CLOUD_MODEL=gemini-3.7-flash
