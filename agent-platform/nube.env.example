# Copiar a /etc/yap/nube.env en el Linux del laboratorio (root-only).
#   sudo cp agent-platform/nube.env.example /etc/yap/nube.env
#   sudo chmod 600 /etc/yap/nube.env
# Cargar antes de yap:
#   set -a; . /etc/yap/nube.env; set +a
#   python3 yap.py nube

YAP_CLOUD_ENABLED=1
YAP_CLOUD_BACKEND=agent_platform
YAP_CLOUD_MODEL=gemini-3.7-flash
YAP_CLOUD_PROJECT=yap-nube-REEMPLAZA
YAP_CLOUD_LOCATION=southamerica-west1
YAP_CLOUD_ENGINE_ID=REEMPLAZA_EL_NUMERO
YAP_CLOUD_TIMEOUT=20

# Token de flota (NO lo subas a git). O usa el archivo:
# YAP_CLOUD_TOKEN=
YAP_CLOUD_TOKEN_FILE=/etc/yap/cloud-token
