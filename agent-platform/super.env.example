# Copiar a /etc/yap/super.env en el Linux del laboratorio (root-only).
#   sudo cp agent-platform/super.env.example /etc/yap/super.env
#   sudo chmod 600 /etc/yap/super.env
# Cargar antes de yap:
#   set -a; . /etc/yap/super.env; set +a
#   python3 yap.py super

# Auto: Gradio Cloud Run. Forzar off: YAP_SUPER_ENABLED=0
# YAP_SUPER_ENABLED=1
# YAP_SUPER_ENDPOINT=https://genai-app-superyap-1-1788986315174-114418439872.southamerica-west1.run.app
# Contrato JSON opcional (aula):
# YAP_SUPER_ENDPOINT=http://137.184.146.113:8742/v1/query
YAP_SUPER_TIMEOUT=90
# llama-cli local: 180 s (3 min). Luego Gradio Cloud Run.
# YAP_LLAMA_TIMEOUT=180

# Obligatorio solo si Super Yap no es loopback ni el pin Gradio:
# YAP_SUPER_TOKEN=
# YAP_SUPER_TOKEN_FILE=/etc/yap/super-token
# YAP_SUPER_HOSTS=super.yap.lab
