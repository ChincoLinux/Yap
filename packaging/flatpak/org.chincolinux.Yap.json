{
  "app-id": "org.chincolinux.Yap",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "yap",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=home",
    "--filesystem=/etc/yap:ro",
    "--filesystem=/opt/yap/models:ro",
    "--env=YAP_CONFIG_DIR=$HOME/.config/yap",
    "--device=dri",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "yap",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 yap.py /app/lib/yap/yap.py",
        "install -Dm644 yap_core.py /app/lib/yap/yap_core.py",
        "cp -r yap /app/lib/yap/yap",
        "install -Dm755 llama-cli /app/bin/llama-cli",
        "install -Dm644 whitelist/apps.conf /app/share/yap/whitelist/apps.conf",
        "install -Dm644 whitelist/web.conf /app/share/yap/whitelist/web.conf",
        "install -Dm644 whitelist/pseint/ejercicios.conf /app/share/yap/whitelist/pseint/ejercicios.conf",
        "for f in cursos/*.json; do install -Dm644 $f /app/share/yap/cursos/$(basename $f); done",
        "install -Dm644 packaging/flatpak/org.chincolinux.Yap.desktop /app/share/applications/org.chincolinux.Yap.desktop",
        "install -Dm644 README.md /app/share/doc/yap/README.md",
        "install -Dm644 LICENSE /app/share/doc/yap/LICENSE",
        "install -Dm755 packaging/flatpak/yap-wrapper.sh /app/bin/yap"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
