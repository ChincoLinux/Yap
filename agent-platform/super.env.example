# Copiar a /etc/yap/super.env en el Linux del laboratorio (root-only).
#   sudo cp agent-platform/super.env.example /etc/yap/super.env
#   sudo chmod 600 /etc/yap/super.env
# Cargar antes de yap:
#   set -a; . /etc/yap/super.env; set +a
#   python3 yap.py super

YAP_SUPER_ENABLED=1
YAP_SUPER_ENDPOINT=http://127.0.0.1:8742/v1/query
YAP_SUPER_TIMEOUT=90
# Super Yap solo arranca / se usa con ≥7000 MB libres.
# YAP_SUPER_FORCE=1
# YAP_SUPER_RAM_MB=8192

# Obligatorio solo si Super Yap no es loopback (PC del aula en 10.x / 192.168.x):
# YAP_SUPER_TOKEN=
# YAP_SUPER_TOKEN_FILE=/etc/yap/super-token
# YAP_SUPER_HOSTS=super.yap.lab

# En el host de 8 GB:
# YAP_SUPER_MODEL_PATH=/opt/yap/models/Llama-3.1-8B-Instruct-Q4_K_M.gguf
# YAP_SUPER_BIND=127.0.0.1
# YAP_SUPER_PORT=8742
# YAP_SUPER_THREADS=4
# YAP_SUPER_CTX=4096
# YAP_SUPER_LLAMA_SERVER=http://127.0.0.1:8743/completion
